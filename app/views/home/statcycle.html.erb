<h1>7 day player and team cycle watch</h1>
<hr>
<div class="container">
	<div class="row">
		<div class="col-4">
			<% player_stat_cycle.each do |k,v| %>
				<h3><%= k %>: <small><%= v %></small></h3>
			<% end %>
		</div>
		<div class="col-4">
			<% team_stat_cycle.each do |k,v| %>
				<h3><%= k %>: <small><%= v %></small></h3>
			<% end %>
		</div>
	</div>
</div>